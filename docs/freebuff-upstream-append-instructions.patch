+import { describe, expect, test } from 'bun:test'
+import { mkdtemp, writeFile, symlink, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { loadAppendInstructions } from './append-instructions'
+
+describe('explicit additive instructions file', () => {
+  test('unset input preserves default configuration', async () => {
+    expect(await loadAppendInstructions()).toBeUndefined()
+  })
+  test('reads private UTF-8 independently of visible task', async () => {
+    const dir = await mkdtemp(join(tmpdir(), 'freebuff-instructions-'))
+    try {
+      const file = join(dir, 'system.md')
+      const content = 'Private host instructions: 你好.\n'
+      await writeFile(file, content, { mode: 0o600 })
+      expect(await loadAppendInstructions(file)).toBe(content)
+    } finally {
+      await rm(dir, { recursive: true, force: true })
+    }
+  })
+  test('invalid or unreadable configuration fails before client admission', async () => {
+    const dir = await mkdtemp(join(tmpdir(), 'freebuff-instructions-'))
+    try {
+      for (const input of ['', 'relative.md', dir, join(dir, 'missing')]) {
+        await expect(loadAppendInstructions(input)).rejects.toThrow()
+      }
+      const file = join(dir, 'system.md')
+      for (const content of [Buffer.alloc(0), Buffer.from('  '), Buffer.from([0xff]), Buffer.from('a\0b'), Buffer.alloc(65537, 65)]) {
+        await writeFile(file, content)
+        await expect(loadAppendInstructions(file)).rejects.toThrow()
+      }
+      await writeFile(file, 'valid')
+      const link = join(dir, 'link')
+      await symlink(file, link)
+      await expect(loadAppendInstructions(link)).rejects.toThrow()
+    } finally {
+      await rm(dir, { recursive: true, force: true })
+    }
+  })
+})
