+import { constants } from 'node:fs'
+import { open } from 'node:fs/promises'
+import { isAbsolute } from 'node:path'
+
+const MAX_BYTES = 64 * 1024
+
+/** Proposed explicit per-process host input. Unset preserves native defaults. */
+export async function loadAppendInstructions(path?: string): Promise<string | undefined> {
+  if (path === undefined) return undefined
+  if (!isAbsolute(path) || /[\0\r\n]/.test(path)) {
+    throw new Error('Invalid append instructions path')
+  }
+  // Linux proposal: reject symlinks and special files before reading.
+  const file = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK)
+  try {
+    const stat = await file.stat()
+    if (!stat.isFile() || stat.size === 0 || stat.size > MAX_BYTES) {
+      throw new Error('Invalid append instructions file')
+    }
+    // A bounded read also handles growth after fstat without unbounded allocation.
+    const bytes = Buffer.alloc(MAX_BYTES + 1)
+    let length = 0
+    while (length < bytes.length) {
+      const { bytesRead } = await file.read(bytes, length, bytes.length - length, null)
+      if (bytesRead === 0) break
+      length += bytesRead
+    }
+    if (length === 0 || length > MAX_BYTES) {
+      throw new Error('Invalid append instructions size')
+    }
+    const text = new TextDecoder('utf-8', { fatal: true }).decode(bytes.subarray(0, length))
+    if (!text.trim() || text.includes('\0')) {
+      throw new Error('Invalid append instructions text')
+    }
+    return text
+  } finally {
+    await file.close()
+  }
+}
