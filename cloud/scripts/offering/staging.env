# Staging offering, read by scripts/deploy-staging.sh. One NAME=VALUE per line,
# taken literally (no quotes, no expansion). A variable already set in the
# deploying shell wins, including an explicit empty value.

# Every provider staging serves, and the deployment default. NodeOps is retired.
AO_CLOUD_SANDBOX_PROVIDERS=coder,freestyle
AO_CLOUD_SANDBOX_PROVIDER=coder

# Providers an organization may use only with a matching WorkOS org
# `capabilities` entry. Orgs without that metadata key (and personal sign-ins)
# get AO_CLOUD_DEFAULT_ORG_CAPABILITIES instead.
AO_CLOUD_CAPABILITY_GATED_PROVIDERS=coder,freestyle
AO_CLOUD_DEFAULT_ORG_CAPABILITIES=freestyle

# self_serve: subject to Stripe plans when billing is enabled (the stripe secret
# exists). contract: never billed through Stripe. WorkOS org metadata
# `billing=contract` overrides this per organization.
AO_CLOUD_DEFAULT_ORG_BILLING=self_serve
# Comma list of plan features gated behind a paid plan. Empty gates nothing.
AO_CLOUD_PAYWALLED_FEATURES=

# 0 keeps Coder workspaces warm (no idle teardown). Freestyle pauses cheaply.
AO_CLOUD_IDLE_PAUSE_THRESHOLD=0
AO_CLOUD_FREESTYLE_IDLE_PAUSE_THRESHOLD=15m

# Coder rollout flags (true or false). New sessions get the readable
# <prefix>-o-/-w- workspace names, and an ao-worker session checks out in the
# project's working folder. See docs/deployment.md, "Coder rollout flags".
AO_CLOUD_CODER_READABLE_NAMES=true
AO_CLOUD_CODER_WORKER_WORKING_FOLDER=true
