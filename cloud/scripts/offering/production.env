# Production offering, read by scripts/promote-production.sh. One NAME=VALUE per
# line, taken literally (no quotes, no expansion). A variable already set in
# the promoting shell wins, including an explicit empty value.

# Production declares its own providers. They must be a subset of what the
# healthy staging task serves, never a provider staging has not exercised.
# Freestyle joins only once ao-cloud/production/freestyle exists and the
# production artifacts bucket is in place (docs/deployment.md, Go-live
# checklist): then set AO_CLOUD_SANDBOX_PROVIDERS=coder,freestyle here.
AO_CLOUD_SANDBOX_PROVIDERS=coder
AO_CLOUD_SANDBOX_PROVIDER=coder

# Gate both providers. B2B organizations get Coder through WorkOS org metadata
# `capabilities=coder`; everyone else gets the default capabilities.
AO_CLOUD_CAPABILITY_GATED_PROVIDERS=coder,freestyle
AO_CLOUD_DEFAULT_ORG_CAPABILITIES=freestyle

# Billing stays off until ao-cloud/production/stripe exists, whatever this says.
AO_CLOUD_DEFAULT_ORG_BILLING=self_serve
AO_CLOUD_PAYWALLED_FEATURES=

AO_CLOUD_IDLE_PAUSE_THRESHOLD=0
AO_CLOUD_FREESTYLE_IDLE_PAUSE_THRESHOLD=15m
