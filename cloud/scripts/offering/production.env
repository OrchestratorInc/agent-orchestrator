# Production offering, read by scripts/promote-production.sh. One NAME=VALUE per
# line, taken literally (no quotes, no expansion). A variable already set in
# the promoting shell wins, including an explicit empty value.

# Production declares its own providers. They must be a subset of what the
# healthy staging task serves, never a provider staging has not exercised.
# Freestyle needs ao-cloud/production/freestyle and the production artifacts
# bucket (docs/deployment.md, Go-live checklist); both exist as of 2026-10-12.
AO_CLOUD_SANDBOX_PROVIDERS=coder,freestyle
AO_CLOUD_SANDBOX_PROVIDER=coder

# Gate both providers. B2B organizations get Coder through WorkOS org metadata
# `capabilities=coder`; everyone else gets the default capabilities.
AO_CLOUD_CAPABILITY_GATED_PROVIDERS=coder,freestyle
AO_CLOUD_DEFAULT_ORG_CAPABILITIES=freestyle

# Billing stays off until ao-cloud/production/stripe exists, whatever this says.
AO_CLOUD_DEFAULT_ORG_BILLING=self_serve
AO_CLOUD_PAYWALLED_FEATURES=

AO_CLOUD_IDLE_PAUSE_THRESHOLD=0
AO_CLOUD_FREESTYLE_IDLE_PAUSE_THRESHOLD=15m

# Cloud session artifacts. 1 turns them on for every organization; the control
# plane then needs this bucket (versioned, private) and its task role's access
# to it (docs/deployment.md). It holds customer files and is not the
# ao-cloud-production-artifacts bucket of worker binaries.
AO_CLOUD_ARTIFACTS=0
AO_CLOUD_ARTIFACT_BUCKET=ao-cloud-production-tenant-artifacts
AO_CLOUD_ARTIFACT_REGION=eu-north-1
# Coder rollout flags (true or false). Off until the release that introduced
# them is the rollback target: an older control plane computes the legacy
# workspace name and ignores the working folder, so it would lose sessions
# created with these on. Turn them on one release after it ships. See
# docs/deployment.md, "Coder rollout flags".
AO_CLOUD_CODER_READABLE_NAMES=false
AO_CLOUD_CODER_WORKER_WORKING_FOLDER=false
