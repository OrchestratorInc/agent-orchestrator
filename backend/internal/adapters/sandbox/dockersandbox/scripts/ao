#!/bin/sh
# AO sandbox relay client (#6663). Inside a sandbox container this replaces the
# `ao` CLI: it hands argv and stdin to the AO supervisor on the host through a
# mounted spool directory and replays the host command's output and exit code.
set -eu
relay="${AO_SANDBOX_RELAY:?AO_SANDBOX_RELAY is not set}"
rnd="$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d ' ')"
[ -n "$rnd" ] || rnd="$(date +%N 2>/dev/null | tr -cd '0-9')"
[ -n "$rnd" ] || rnd=0
id="$(date +%s)-$$-$rnd"
tmp="$relay/req/$id.tmp"
mkdir -p "$tmp"
for arg in "$@"; do printf '%s\0' "$arg"; done > "$tmp/argv"
# Only hooks read stdin (the harness pipes their payload and closes it). Other
# commands may get a pipe that never closes from an agent's tool runner.
if [ "${1:-}" = hooks ] && [ ! -t 0 ]; then cat > "$tmp/stdin"; else : > "$tmp/stdin"; fi
mv "$tmp" "$relay/req/$id"
resp="$relay/resp/$id"
deadline=$(( $(date +%s) + 65 ))
while [ ! -d "$resp" ]; do
	if [ "$(date +%s)" -ge "$deadline" ]; then
		rm -rf "$relay/req/$id" 2>/dev/null || true
		echo "ao: sandbox relay timed out" >&2
		exit 124
	fi
	sleep 0.05 2>/dev/null || sleep 1
done
cat "$resp/stdout"
cat "$resp/stderr" >&2
code="$(cat "$resp/exit")"
rm -rf "$resp"
exit "$code"
