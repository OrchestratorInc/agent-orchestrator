# Runs in a helper container that shares the sandbox's network namespace.
# Blackholes every address the host aliases resolve to, then proves the
# daemon's loopback port ($1, 0 = unknown) is unreachable, directly and through
# Docker Desktop's HTTP proxy. $2 = 1 requires at least one alias to resolve.
# Exit 3 = reachable, 4 = no alias resolved although one was required.
port=$1
require_alias=$2
gw=$(ip route show default | awk '$1 == "default" { print $3; exit }')

addrs=
tries=0
while [ -z "$addrs" ] && [ "$tries" -lt 3 ]; do
	[ "$tries" -gt 0 ] && sleep 1
	tries=$((tries + 1))
	for h in host.docker.internal gateway.docker.internal host.internal host.lima.internal; do
		for a in $(getent ahosts "$h" 2>/dev/null | awk '{print $1}'); do
			a=${a%%\%*} # drop an IPv6 zone such as %eth0
			case $a in [fF][eE][89aAbB][0-9a-fA-F]:*) continue ;; esac # link-local
			case " $addrs " in *" $a "*) ;; *) addrs="$addrs $a" ;; esac
		done
	done
done
if [ -z "$addrs" ] && [ "$require_alias" = 1 ]; then
	echo "no Docker host alias resolved" >&2
	exit 4
fi

# Each IPv4 alias also blackholes its enclosing /24, which holds Docker
# Desktop's other host services (its HTTP proxy at .7). A /24 is skipped when
# it is loopback, holds the default gateway, or is on-link, since that would
# cut the container's own network. Decided before any route is added.
routes=
for a in $addrs; do
	case $a in
	*:*) routes="$routes -6:$a/128" ;;
	*)
		routes="$routes -4:$a/32"
		net=${a%.*}
		case $a in 127.*) continue ;; esac
		[ -n "$gw" ] && [ "${gw%.*}" = "$net" ] && continue
		ip route get "$a" 2>/dev/null | grep -q ' via ' || continue
		case " $routes " in *" -4:$net.0/24 "*) ;; *) routes="$routes -4:$net.0/24" ;; esac
		;;
	esac
done
for r in $routes; do
	fam=${r%%:*}
	dst=${r#*:}
	if ! ip "$fam" route replace blackhole "$dst"; then
		# With IPv6 off in the netns there is no v6 route to block.
		[ "$fam" = -6 ] && [ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null)" = 1 ] && continue
		echo "ip $fam route replace blackhole $dst failed" >&2
		exit 1
	fi
done

[ "$port" = 0 ] && exit 0
# The default gateway is probed but not blackholed: that would cut internet.
for a in $addrs $gw; do
	if nc -z -w 2 "$a" "$port" </dev/null >/dev/null 2>&1; then
		echo "REACHABLE $a"
		exit 3
	fi
done
# Docker Desktop's HTTP proxy tunnels to host loopback.
proxies="$(awk '$1 == "nameserver" && $2 !~ /^127\./ { print $2 }' /etc/resolv.conf 2>/dev/null) http.docker.internal 192.168.65.7"
for p in $proxies; do
	status=$(printf 'CONNECT 127.0.0.1:%s HTTP/1.1\r\nHost: 127.0.0.1:%s\r\n\r\n' "$port" "$port" | nc -w 2 "$p" 3128 2>/dev/null | head -n 1)
	case $status in *" 200"*)
		echo "REACHABLE proxy $p"
		exit 3
		;;
	esac
done
exit 0
