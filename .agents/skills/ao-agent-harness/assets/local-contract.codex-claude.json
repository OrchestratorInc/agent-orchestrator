{
  "schemaVersion": 1,
  "agents": {
    "codex": {
      "binary": "codex",
      "versionArgs": ["--version"],
      "integration": { "args": ["login", "status"], "expect": "Logged in" },
      "session": {
        "args": ["exec", "--skip-git-repo-check", "--dangerously-bypass-approvals-and-sandbox", "{prompt}"],
        "proofFile": "LOCAL_AUDIT_PROOF.json"
      },
      "models": { "args": ["debug", "models"], "format": "json" },
      "interrupt": { "input": "\u001b", "settleTimeoutMs": 10000 },
      "restoredReady": {
        "patterns": [
          "›[ \\t\\u00a0]*(?:Ask Codex to do anything|Explain this codebase|Summarize recent commits|Implement \\{feature\\}|Find and fix a bug in @filename|Write tests for @filename|Improve documentation in @filename|Run /review on my current changes|Use /skills to list available skills)[ \\t]*\\n(?:[ \\t]*\\n)?[^\\n]*·[^\\n]*(?:\\n[^\\n]*){0,2}\\s*$"
        ]
      },
      "instructions": { "tui": { "channel": "flag" }, "chat": { "channel": "protocol" } }
    },
    "claude-code": {
      "binary": "claude",
      "versionArgs": ["--version"],
      "integration": { "args": ["auth", "status"], "expect": "\"loggedIn\": true" },
      "session": {
        "args": ["-p", "--dangerously-skip-permissions", "{prompt}"],
        "proofFile": "LOCAL_AUDIT_PROOF.json"
      },
      "interrupt": { "input": "\u001b", "settleTimeoutMs": 10000 },
      "restoredReady": {
        "patterns": [
          "❯[ \\t\\u00a0]*\\n[ \\t]*─{10,}[ \\t]*(?:\\n(?![^\\n]*esc to interrupt)[^\\n]*){0,3}\\s*$"
        ]
      },
      "instructions": { "tui": { "channel": "flag" }, "chat": { "channel": "protocol" } }
    }
  }
}
