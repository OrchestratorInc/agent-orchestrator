{
  "name": "@agent-orchestrator/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Expo mobile supervisor for Agent Orchestrator",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:perf": "expo start --dev-client --no-dev --minify",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsgo --noEmit",
    "build": "npm run typecheck",
    "postinstall": "patch-package",
    "test": "vitest run"
  },
  "dependencies": {
    "@ao/response-selection": "file:./native/response-selection",
    "@bsky.app/react-native-uitextview": "2.4.0",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo/ui": "~58.0.23",
    "@expo/vector-icons": "^15.0.3",
    "@fressh/react-native-xtermjs-webview": "^0.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-in-app-updates": "^0.12.0",
    "expo-linking": "~58.0.14",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^1.47.0",
    "posthog-react-native": "^4.62.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "expo": {
    "autolinking": {
      "apple": {
        "exclude": [
          "expo-in-app-updates"
        ]
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "patch-package": "^8.0.1",
    "pngjs": "3.4.0",
    "react-test-renderer": "^19.2.3",
    "sf-symbols-typescript": "^2.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
