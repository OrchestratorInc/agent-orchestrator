+/** Material 3's gap between a menu and the edges of the space it may use. */
+private val MenuVerticalMargin = 48.dp
+
+/** Material 3's padding above the first item and below the last. */
+private val MenuVerticalPadding = 8.dp
+
+/**
+ * Places a menu as Material 3's DropdownMenu does (below its anchor, else above,
+ * else centred, else against the bottom), but within the window's real visible
+ * area.
+ *
+ * Material's own provider receives only the visible area's size and treats it
+ * as starting at the window's top. An edge-to-edge window starts under the
+ * status bar while its visible area starts below it, so a menu that fits just
+ * above its anchor looked too tall and was pushed up by the status bar's height
+ * (plus the margin): on a Pixel 10a it ended 140 px above the button that
+ * opened it. The visible frame is read in window coordinates instead, so its
+ * top and bottom (status bar, navigation bar, keyboard) are both honoured.
+ */
+private class VisibleAreaMenuPositionProvider(
+  private val view: View,
+  private val density: Density
+) : PopupPositionProvider {
+  private val frame = Rect()
+  private val origin = IntArray(2)
+
+  override fun calculatePosition(
+    anchorBounds: IntRect,
+    windowSize: IntSize,
+    layoutDirection: LayoutDirection,
+    popupContentSize: IntSize
+  ): IntOffset {
+    view.getWindowVisibleDisplayFrame(frame)
+    // The app's window, which the anchor and the popup's position are measured
+    // in, also for a menu opened from inside another menu, whose own view sits
+    // in that menu's popup window.
+    val appWindow = view.context.findActivity()?.window?.decorView
+    if (appWindow != null) appWindow.getLocationOnScreen(origin) else origin.fill(0)
+    // The visible area in that window's coordinates.
+    val left = frame.left - origin[0]
+    val top = frame.top - origin[1]
+    val right = left + frame.width()
+    val bottom = top + frame.height()
+    val margin = with(density) { MenuVerticalMargin.roundToPx() }
+
+    val toRight = anchorBounds.left
+    val toLeft = anchorBounds.right - popupContentSize.width
+    val toEnd = right - popupContentSize.width
+    val x = (if (layoutDirection == LayoutDirection.Ltr) sequenceOf(toRight, toLeft, toEnd) else sequenceOf(toLeft, toRight, left))
+      .firstOrNull { it >= left && it + popupContentSize.width <= right }
+      ?: toLeft
+
+    val toBottom = maxOf(anchorBounds.bottom, top + margin)
+    val toTop = anchorBounds.top - popupContentSize.height
+    val toCenter = anchorBounds.top - popupContentSize.height / 2
+    val toAreaBottom = bottom - popupContentSize.height - margin
+    val y = sequenceOf(toBottom, toTop, toCenter, toAreaBottom)
+      .firstOrNull { it >= top + margin && it + popupContentSize.height <= bottom - margin }
+      ?: toTop
+
+    return IntOffset(x, y)
+  }
+}
