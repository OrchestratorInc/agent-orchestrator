+package expo.modules.ui.colors
+
+import android.content.Context
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material3.ColorScheme
+import androidx.compose.material3.Shapes
+import androidx.compose.material3.Typography
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.text.TextStyle
+import androidx.compose.ui.text.font.FontFamily
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.unit.dp
+import expo.modules.kotlin.records.Field
+import expo.modules.kotlin.records.Record
+import expo.modules.ui.resolveFontFamily
+
+/**
+ * The app's own theme for every Host: its palette in place of the wallpaper's
+ * dynamic colours, its type family in place of Roboto, and its corner for the
+ * smallest shapes. Set from JS through `setAppTheme` whenever the palette
+ * changes; a Host reads it during composition, so every Host on screen
+ * recomposes with the new theme.
+ */
+internal class AppThemeOptions : Record {
+  /** Which scheme the colours are for. A Host in the other scheme keeps its default. */
+  @Field val dark: Boolean = true
+
+  /** Colour roles by `ColorScheme` property name, as ARGB integers. Missing roles keep the default. */
+  @Field val colors: Map<String, Double> = emptyMap()
+
+  /** Font family names for the regular, medium and semibold weights. */
+  @Field val fonts: Map<String, String> = emptyMap()
+
+  /** Corner radius of the extra-small shape (menus, outlined fields, snackbars), in dp. */
+  @Field val extraSmallCorner: Double? = null
+}
+
+internal object AppTheme {
+  val options = mutableStateOf<AppThemeOptions?>(null)
+}
+
+internal fun ColorScheme.withAppColors(colors: Map<String, Double>): ColorScheme {
+  fun role(name: String, fallback: Color): Color = colors[name]?.let { Color(it.toLong().toInt()) } ?: fallback
+  return copy(
+    primary = role("primary", primary),
+    onPrimary = role("onPrimary", onPrimary),
+    primaryContainer = role("primaryContainer", primaryContainer),
+    onPrimaryContainer = role("onPrimaryContainer", onPrimaryContainer),
+    inversePrimary = role("inversePrimary", inversePrimary),
+    secondary = role("secondary", secondary),
+    onSecondary = role("onSecondary", onSecondary),
+    secondaryContainer = role("secondaryContainer", secondaryContainer),
+    onSecondaryContainer = role("onSecondaryContainer", onSecondaryContainer),
+    tertiary = role("tertiary", tertiary),
+    onTertiary = role("onTertiary", onTertiary),
+    tertiaryContainer = role("tertiaryContainer", tertiaryContainer),
+    onTertiaryContainer = role("onTertiaryContainer", onTertiaryContainer),
+    background = role("background", background),
+    onBackground = role("onBackground", onBackground),
+    surface = role("surface", surface),
+    onSurface = role("onSurface", onSurface),
+    surfaceVariant = role("surfaceVariant", surfaceVariant),
+    onSurfaceVariant = role("onSurfaceVariant", onSurfaceVariant),
+    surfaceTint = role("surfaceTint", surfaceTint),
+    inverseSurface = role("inverseSurface", inverseSurface),
+    inverseOnSurface = role("inverseOnSurface", inverseOnSurface),
+    error = role("error", error),
+    onError = role("onError", onError),
+    errorContainer = role("errorContainer", errorContainer),
+    onErrorContainer = role("onErrorContainer", onErrorContainer),
+    outline = role("outline", outline),
+    outlineVariant = role("outlineVariant", outlineVariant),
+    scrim = role("scrim", scrim),
+    surfaceBright = role("surfaceBright", surfaceBright),
+    surfaceDim = role("surfaceDim", surfaceDim),
+    surfaceContainer = role("surfaceContainer", surfaceContainer),
+    surfaceContainerHigh = role("surfaceContainerHigh", surfaceContainerHigh),
+    surfaceContainerHighest = role("surfaceContainerHighest", surfaceContainerHighest),
+    surfaceContainerLow = role("surfaceContainerLow", surfaceContainerLow),
+    surfaceContainerLowest = role("surfaceContainerLowest", surfaceContainerLowest)
+  )
+}
+
+/** Material's type scale in the app's family, each style taking the face for its weight. */
+internal fun appTypography(fonts: Map<String, String>, context: Context): Typography? {
+  val regular = resolveFontFamily(fonts["regular"], context)
+  val medium = resolveFontFamily(fonts["medium"], context) ?: regular
+  val semibold = resolveFontFamily(fonts["semibold"], context) ?: medium
+  if (regular == null) return null
+  fun TextStyle.inApp(): TextStyle {
+    val weight = fontWeight ?: FontWeight.Normal
+    val family: FontFamily? = when {
+      weight >= FontWeight.SemiBold -> semibold
+      weight >= FontWeight.Medium -> medium
+      else -> regular
+    }
+    return copy(fontFamily = family)
+  }
+  val base = Typography()
+  return Typography(
+    displayLarge = base.displayLarge.inApp(),
+    displayMedium = base.displayMedium.inApp(),
+    displaySmall = base.displaySmall.inApp(),
+    headlineLarge = base.headlineLarge.inApp(),
+    headlineMedium = base.headlineMedium.inApp(),
+    headlineSmall = base.headlineSmall.inApp(),
+    titleLarge = base.titleLarge.inApp(),
+    titleMedium = base.titleMedium.inApp(),
+    titleSmall = base.titleSmall.inApp(),
+    bodyLarge = base.bodyLarge.inApp(),
+    bodyMedium = base.bodyMedium.inApp(),
+    bodySmall = base.bodySmall.inApp(),
+    labelLarge = base.labelLarge.inApp(),
+    labelMedium = base.labelMedium.inApp(),
+    labelSmall = base.labelSmall.inApp()
+  )
+}
+
+internal fun appShapes(extraSmallCorner: Double?): Shapes? {
+  val corner = extraSmallCorner ?: return null
+  return Shapes().copy(extraSmall = RoundedCornerShape(corner.dp))
+}
