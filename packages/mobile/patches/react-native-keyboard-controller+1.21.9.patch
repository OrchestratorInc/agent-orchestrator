+/**
+ * The overlay window's root. JS marks the part of the screen the overlay
+ * claims with a view whose nativeID is [TOUCH_REGION_ID]; the window then ends
+ * at that view's bottom (or the foot of its fade over the keys' top rows, view
+ * [FADE_ID], where a tap only closes it), so the keyboard below is outside the window and
+ * gets its own touches (since Android 12 a window from another app over a
+ * point blocks touches there, so the frame itself must end, not only its
+ * touchable area). On API 33+ the part above the region is made not
+ * touchable too, so the app's header gets its touches. A touch outside the
+ * window or its touchable region is reported to JS as
+ * `KeyboardController::overKeyboardTouchOutside`. With no region view, the
+ * window covers the screen as before.
+ */
+@SuppressLint("ViewConstructor")
+class OverKeyboardWindowRoot(
+  private val reactContext: ThemedReactContext,
+  private val hostView: View,
+  private val windowManager: WindowManager,
+) : FrameLayout(reactContext) {
+  private var region: Rect? = null
+  private var drawnBottom: Int? = null
+  private val preDraw =
+    ViewTreeObserver.OnPreDrawListener {
+      syncRegion()
+      true
+    }
+
+
+  init {
+    clipChildren = true
+    val display = reactContext.getDisplaySize()
+    addView(hostView, LayoutParams(display.x, display.y))
+  }
+
+  override fun onAttachedToWindow() {
+    super.onAttachedToWindow()
+    viewTreeObserver.addOnPreDrawListener(preDraw)
+  }
+
+  override fun onDetachedFromWindow() {
+    viewTreeObserver.removeOnPreDrawListener(preDraw)
+    region = null
+    drawnBottom = null
+    super.onDetachedFromWindow()
+  }
+
+  private fun syncRegion() {
+    val marker = ReactFindViewUtil.findView(hostView, TOUCH_REGION_ID)
+    val next =
+      if (marker != null && marker.width > 0 && marker.height > 0 && hostView is android.view.ViewGroup) {
+        val rect = Rect(0, 0, marker.width, marker.height)
+        hostView.offsetDescendantRectToMyCoords(marker, rect)
+        rect
+      } else {
+        null
+      }
+    // The window also draws the overlay's fade down over the keys' top rows
+    // (JS's view with nativeID [FADE_ID]); taps there are not the keyboard's,
+    // and land outside the touchable region, which closes the overlay.
+    val fadeView = ReactFindViewUtil.findView(hostView, FADE_ID)
+    val fadeBottom =
+      if (next != null && fadeView != null && fadeView.height > 0 && hostView is android.view.ViewGroup) {
+        val rect = Rect(0, 0, fadeView.width, fadeView.height)
+        hostView.offsetDescendantRectToMyCoords(fadeView, rect)
+        maxOf(next.bottom, rect.bottom)
+      } else {
+        next?.bottom
+      }
+    if (next == region && fadeBottom == drawnBottom) return
+    region = next
+    drawnBottom = fadeBottom
+    val params = layoutParams as? WindowManager.LayoutParams ?: return
+    val height = fadeBottom ?: WindowManager.LayoutParams.MATCH_PARENT
+    if (params.height != height) {
+      params.height = height
+      try {
+        windowManager.updateViewLayout(this, params)
+      } catch (
+        @Suppress("detekt:TooGenericExceptionCaught") e: RuntimeException,
+      ) {
+        Logger.w(TAG, "Can not resize the overlay window", e)
+      }
+    }
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+      rootSurfaceControl?.setTouchableRegion(next?.let { Region(it.left, it.top, it.right, fadeBottom ?: it.bottom) })
+    }
+  }
+
+  override fun dispatchTouchEvent(event: MotionEvent): Boolean {
+    // A tap on the fade over the keys is outside the overlay too.
+    val below = region?.bottom
+    if (event.actionMasked == MotionEvent.ACTION_DOWN && below != null && event.y > below) {
+      reactContext.emitEvent("KeyboardController::overKeyboardTouchOutside", Arguments.createMap())
+      return true
+    }
+    if (event.actionMasked == MotionEvent.ACTION_OUTSIDE) {
+      reactContext.emitEvent("KeyboardController::overKeyboardTouchOutside", Arguments.createMap())
+      return true
+    }
+    return super.dispatchTouchEvent(event)
+  }
+
+  companion object {
+    const val TOUCH_REGION_ID = "RNKC_OverKeyboardTouchRegion"
+    const val FADE_ID = "RNKC_OverKeyboardFade"
+  }
+}
