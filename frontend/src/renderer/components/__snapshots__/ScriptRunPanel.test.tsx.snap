          <button
            aria-label="Copy output"
            class="flex items-center justify-center rounded-md text-muted-foreground transition-[background-color,color,transform] hover:bg-interactive-hover hover:text-foreground absolute right-1 top-1 size-6 bg-background"
            data-slot="tooltip-trigger"
            data-state="closed"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-copy size-3"
              fill="none"
              height="24"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect
                height="14"
                rx="2"
                ry="2"
                width="14"
                x="8"
                y="8"
              />
              <path
                d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
              />
            </svg>
          </button>
        </div>
      </div>
    </li>
    <li
      class="flex min-h-8 items-center gap-2 px-2.5 py-1 pr-[calc(0.625rem+var(--script-run-notice-clearance,0px))]"
      data-status="pending"
      data-testid="script-step"
    >
      <svg
        aria-hidden="true"
        class="lucide lucide-circle size-3 shrink-0 text-passive"
        fill="none"
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle
          cx="12"
          cy="12"
          r="10"
        />
      </svg>
      <span
        class="min-w-0 flex-1 truncate font-mono text-muted-foreground"
      >
        Step 3
      </span>
      <span
        class="sr-only"
      >
        Not started
      </span>
      <span
        aria-hidden="true"
        class="size-3 shrink-0"
      />
    </li>
  </ol>
</section>
`;
