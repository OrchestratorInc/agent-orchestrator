                height="14"
                rx="2"
                ry="2"
                width="14"
                x="8"
                y="8"
              />
              <path
                d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
              />
            </svg>
          </button>
        </div>
        <div
          class="flex flex-col gap-0.5 px-1 text-caption leading-relaxed text-muted-foreground select-text"
        >
          <p
            class="text-foreground"
          >
            This step ran as ao-worker, which cannot use Docker.
          </p>
          <p
            class="break-words"
          >
            Exited with code 1
          </p>
          <p
            class="break-words"
          >
            Ran as ao-worker (groups: ao-worker)
          </p>
          <p
            class="break-words"
          >
            Ran in /home/coder/app
          </p>
          <p
            class="break-words"
          >
            Showing the end of the output. Full output: /home/coder/.ao/setup-logs/step-2.log
          </p>
        </div>
      </div>
    </li>
    <li
      class="flex min-h-8 items-center gap-2 px-2.5 py-1 pr-[calc(0.625rem+var(--script-run-notice-clearance,0px))]"
      data-status="skipped"
      data-testid="script-step"
    >
