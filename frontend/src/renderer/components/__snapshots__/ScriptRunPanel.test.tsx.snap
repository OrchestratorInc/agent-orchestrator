      >
        <circle
          cx="12"
          cy="12"
          r="10"
        />
      </svg>
      <span
        class="min-w-0 flex-1 truncate font-mono text-muted-foreground"
        title="npm test"
      >
        npm test
      </span>
      <span
        class="sr-only"
      >
        Skipped
      </span>
      <span
        aria-hidden="true"
        class="shrink-0 text-caption text-passive"
      >
        Skipped
      </span>
      <span
        aria-hidden="true"
        class="size-3 shrink-0"
      />
    </li>
  </ol>
</section>
`;

