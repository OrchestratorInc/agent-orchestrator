// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ScriptRunPanel > collapses a succeeded run in the timeline and keeps its steps closed when opened 1`] = `
<section
  aria-label="Setup"
  class="flex min-w-0 flex-col overflow-hidden rounded-md border bg-surface/60 border-border"
  data-run-status="succeeded"
  data-testid="script-run-panel"
>
  <div
    aria-atomic="true"
    aria-live="polite"
    class="sr-only"
    data-testid="script-run-announcer"
    role="status"
  />
  <div
    aria-atomic="true"
    aria-live="polite"
    class="sr-only"
    data-testid="script-run-quiet-announcer"
    role="status"
  />
  <button
    aria-controls="_r_a_"
    aria-expanded="true"
    class="group/script-run flex min-h-8 w-full items-center gap-2 px-2.5 py-1.5 text-left hover:bg-interactive-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring/60 pr-[calc(0.625rem+var(--script-run-notice-clearance,0px))]"
    type="button"
  >
    <svg
      aria-hidden="true"
      class="lucide lucide-check size-3.5 shrink-0 text-success"
      fill="none"
      height="24"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M20 6 9 17l-5-5"
      />
    </svg>
    <span
      class="flex min-w-0 flex-1 items-baseline gap-1.5 text-xs"
    >
      <span
        class="shrink-0 font-medium text-foreground"
      >
        Setup
      </span>
      <span
        class="min-w-0 truncate text-muted-foreground"
      >
        Succeeded
      </span>
    </span>
    <span
      aria-label="Elapsed 0:12"
      class="shrink-0 font-mono text-caption tabular-nums text-muted-foreground"
    >
      0:12
    </span>
    <svg
      aria-hidden="true"
      class="lucide lucide-chevron-right size-3 shrink-0 text-muted-foreground/60 transition-transform group-hover/script-run:text-muted-foreground rotate-90"
      fill="none"
      height="24"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="m9 18 6-6-6-6"
      />
    </svg>
  </button>
  <ol
    class="flex flex-col divide-y divide-border border-t border-border"
    id="_r_a_"
  >
    <li
      class="flex flex-col"
      data-status="succeeded"
      data-testid="script-step"
    >
      <button
        aria-controls="_r_b_"
        aria-expanded="false"
        class="group/script-step flex min-h-8 w-full items-center gap-2 px-2.5 py-1 text-left hover:bg-interactive-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring/60 pr-[calc(0.625rem+var(--script-run-notice-clearance,0px))]"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-check size-3.5 shrink-0 text-success"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M20 6 9 17l-5-5"
          />
        </svg>
        <span
          class="min-w-0 flex-1 truncate font-mono text-foreground"
          title="npm ci"
        >
          npm ci
        </span>
        <span
          class="sr-only"
        >
          Succeeded
        </span>
        <span
          class="shrink-0 font-mono text-caption tabular-nums text-muted-foreground"
        >
          0:04
        </span>
        <svg
          aria-hidden="true"
          class="lucide lucide-chevron-right size-3 shrink-0 text-muted-foreground/60 transition-transform group-hover/script-step:text-muted-foreground"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="m9 18 6-6-6-6"
          />
        </svg>
      </button>
    </li>
    <li
      class="flex flex-col"
      data-status="succeeded"
      data-testid="script-step"
    >
      <button
        aria-controls="_r_c_"
        aria-expanded="false"
        class="group/script-step flex min-h-8 w-full items-center gap-2 px-2.5 py-1 text-left hover:bg-interactive-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring/60 pr-[calc(0.625rem+var(--script-run-notice-clearance,0px))]"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-check size-3.5 shrink-0 text-success"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M20 6 9 17l-5-5"
          />
        </svg>
        <span
          class="min-w-0 flex-1 truncate font-mono text-foreground"
          title="npm run build"
        >
          npm run build
        </span>
        <span
          class="sr-only"
        >
          Succeeded
        </span>
        <span
          class="shrink-0 font-mono text-caption tabular-nums text-muted-foreground"
        >
