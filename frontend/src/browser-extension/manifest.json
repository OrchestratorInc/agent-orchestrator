{
	"manifest_version": 3,
	"name": "AO Browser Bridge",
	"description": "Lets Agent Orchestrator agents work in their own tab groups in this Chrome, with your consent.",
	"version": "0.1.0",
	"minimum_chrome_version": "120",
	"key": "",
	"permissions": ["nativeMessaging", "tabs", "tabGroups", "scripting", "storage", "webNavigation", "webRequest", "debugger"],
	"host_permissions": ["<all_urls>"],
	"background": { "service_worker": "background.js" },
	"action": { "default_title": "AO Browser Bridge", "default_popup": "popup.html" },
	"options_page": "options.html"
}
